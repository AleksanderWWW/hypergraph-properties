n/N*100
(n+1)/(N+2)*100
curve(dbeta(x, shape1 = n+1, shape2 = N-n+1))
curve(pbeta(x, shape1 = n+1, shape2 = N-n+1))
#99%-PI
qbeta(0.005, shape1 = n+1, shape2 = N-n+1)*100
qbeta(0.995, shape1 = n+1, shape2 = N-n+1)*100
#95%-PI
